# ============================================================================
# mRModN 后端配置 / mRModN Backend Configuration
# ============================================================================
# 复制此文件为 .env 并根据本地环境修改 / Copy this file to .env and update with your local settings

# ----------------------------------------------------------------------------
# Redis 配置 / Redis Configuration
# 本地开发使用 localhost，Docker 部署使用 redis（服务名）
# Local development: use localhost; Docker deployment: use redis (service name)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----------------------------------------------------------------------------
# Celery 配置 / Celery Configuration
# 消息队列和结果后端的 Redis 连接地址
# Redis connection URLs for message broker and result backend
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# 任务硬超时（秒）/ Task hard time limit (seconds)
CELERY_TASK_TIME_LIMIT=3600
# 任务软超时（秒）/ Task soft time limit (seconds)
CELERY_TASK_SOFT_TIME_LIMIT=3000

# ----------------------------------------------------------------------------
# 模型配置 / Model Configuration
# ----------------------------------------------------------------------------
# 模型权重文件路径 / Model checkpoint file path
MODEL_CHECKPOINT_PATH=epoch_040.pt
# 模型配置 JSON 文件路径 / Model config JSON file path
MODEL_CONFIG_PATH=json/human.json
# 推理设备：cpu 或 cuda / Inference device: cpu or cuda
MODEL_DEVICE=cpu
# 输入序列目标长度 / Target sequence length
MODEL_TARGET_LENGTH=1001

# ----------------------------------------------------------------------------
# 服务器配置 / Server Configuration
# ----------------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=False

# ----------------------------------------------------------------------------
# 日志配置 / Logging Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT='%(asctime)s - %(name)s - %(levelname)s - [%(funcName)s:%(lineno)d] - %(message)s'
# 日志文件最大字节数（默认 10MB）/ Max log file size in bytes (default 10MB)
LOG_FILE_MAX_BYTES=10485760
# 日志文件备份数量 / Number of log file backups
LOG_FILE_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# 缓存配置 / Cache Configuration
# Redis 预测结果缓存 TTL（秒）/ Redis prediction result cache TTL (seconds)
# ----------------------------------------------------------------------------
REDIS_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# 12 类分类阈值 / Classification Thresholds (12-class)
# 每种 RNA 修饰类型的概率阈值 / Probability threshold for each RNA modification type
# ----------------------------------------------------------------------------
THRESHOLD_12_AM=0.510
THRESHOLD_12_ATOL=0.400
THRESHOLD_12_CM=0.690
THRESHOLD_12_GM=0.710
THRESHOLD_12_TM=0.350
THRESHOLD_12_Y=0.150
THRESHOLD_12_AC4C=0.120
THRESHOLD_12_M1A=0.380
THRESHOLD_12_M5C=0.350
THRESHOLD_12_M6A=0.260
THRESHOLD_12_M6AM=0.570
THRESHOLD_12_M7G=0.130

# ----------------------------------------------------------------------------
# 4 类分类阈值 / Classification Thresholds (4-class)
# 核苷酸组（A/C/G/U）的概率阈值 / Probability threshold for nucleotide groups
# ----------------------------------------------------------------------------
THRESHOLD_4_A=0.980
THRESHOLD_4_C=0.270
THRESHOLD_4_G=0.050
THRESHOLD_4_U=0.050

# ----------------------------------------------------------------------------
# 注意力可视化默认 Top-K / Default Top-K for Attention Visualization
# ----------------------------------------------------------------------------
DEFAULT_TOP_K=3

# ----------------------------------------------------------------------------
# 微信小程序配置 / WeChat Mini Program Configuration
# 从微信小程序管理后台获取 / Get these from WeChat Mini Program admin console
# ----------------------------------------------------------------------------
WX_APPID=your_wechat_appid_here
WX_SECRET=your_wechat_secret_here
